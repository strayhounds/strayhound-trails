# ─────────────────────────────────────────────────────────────
# StrayHound Trails: .gitattributes
# ─────────────────────────────────────────────────────────────

# Docs and scripts: normalize line endings
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.txt  text eol=lf

# Challenge files must stay byte-for-byte identical to the originals.
# No line-ending conversion, no diffs, no merges.
competitions/**/files/** -text -diff -merge

# ── Git LFS: large binary files (forensics, reverse, pwn) ───
# Disk and memory images
*.raw    filter=lfs diff=lfs merge=lfs -text
*.img    filter=lfs diff=lfs merge=lfs -text
*.iso    filter=lfs diff=lfs merge=lfs -text
*.vmdk   filter=lfs diff=lfs merge=lfs -text
*.vdi    filter=lfs diff=lfs merge=lfs -text
*.qcow2  filter=lfs diff=lfs merge=lfs -text
*.E01    filter=lfs diff=lfs merge=lfs -text
*.mem    filter=lfs diff=lfs merge=lfs -text
*.vmem   filter=lfs diff=lfs merge=lfs -text
*.dmp    filter=lfs diff=lfs merge=lfs -text
*.lime   filter=lfs diff=lfs merge=lfs -text

# Network captures
*.pcap    filter=lfs diff=lfs merge=lfs -text
*.pcapng  filter=lfs diff=lfs merge=lfs -text

# Large media (stego, audio/video challenges)
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mkv  filter=lfs diff=lfs merge=lfs -text

# Archives: uncomment only if they are large, to save LFS quota
#*.zip     filter=lfs diff=lfs merge=lfs -text
#*.7z      filter=lfs diff=lfs merge=lfs -text
#*.tar.gz  filter=lfs diff=lfs merge=lfs -text
